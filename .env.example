# ─────────────────────────────────────────────────────────────────────────
# .env.example · ecotech_demo
#
# Plantilla de las variables de entorno. NO contiene valores reales.
# Copie cada sección a su archivo y complete los valores:
#
#   backend/.env       ← sección BACKEND
#   frontend/.env      ← sección INTERFAZ
#
# Propósito de cada variable: docs/variables_entorno.md
# ─────────────────────────────────────────────────────────────────────────

# ═══ BACKEND · backend/.env ══════════════════════════════════════════════
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=<generar: python -c "import secrets; print(secrets.token_urlsafe(50))">
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

DB_NAME=ecotech_demo_db
DB_USER=ecotech_demo_user
DB_PASSWORD=<contraseña local>
DB_HOST=localhost
DB_PORT=5432

FIELD_ENCRYPTION_KEY=<generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
JWT_ACCESO_MINUTOS=15
JWT_RENOVACION_HORAS=8

# ═══ INTERFAZ · frontend/.env ════════════════════════════════════════════
# Toda variable VITE_* es PÚBLICA: se compila dentro del JavaScript.
VITE_API_URL=http://localhost:8000
VITE_SITE_URL=http://localhost:5173
